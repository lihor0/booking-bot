# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111

BUSINESS_NAME=Барбершоп «Борода»
ADDRESS=г. Москва, ул. Примерная, 1
PHONE=+7 (900) 000-00-00

TIMEZONE=Europe/Moscow
WORK_START=10:00
WORK_END=20:00
# Рабочие дни: 1 = пн ... 7 = вс
WORKDAYS=1,2,3,4,5,6
# Шаг сетки записи, минут
SLOT_STEP=30
# На сколько дней вперёд можно записаться
DAYS_AHEAD=14
# Минимум минут от текущего момента до записи
MIN_LEAD=60
# За сколько минут до визита напомнить клиенту
REMIND_BEFORE=120

SERVICES_FILE=services.json
DB_PATH=bookings.db
